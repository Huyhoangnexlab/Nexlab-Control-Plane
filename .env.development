# Chỉ dùng cho `npm run dev` (Next không nạp file này khi build/start production).
# Tự nạp dữ liệu mẫu khi DB trống, và bật các nút «Đăng nhập nhanh» cho tài khoản mẫu ở trang đăng nhập.
CP_AUTO_SEED=1
CP_DEV_LOGIN=1
# Cho phép đăng ký app http://localhost:* trong danh mục (lab). Production phải để trống.
CP_ALLOW_DEV_ORIGINS=1
