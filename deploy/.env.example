# Sao thành .env trên VM (chmod 600). KHÔNG commit giá trị thật.
CP_HOST=cp.<IP-gạch-ngang>.sslip.io
KC_HOST=kc.<IP-gạch-ngang>.sslip.io
PG_PASSWORD=
KC_DB_PASSWORD=
KC_ADMIN_PASSWORD=
CP_SEED_PASSWORD=
# PEM Ed25519 (PKCS8) viết trên MỘT dòng, thay xuống dòng bằng \n
CP_SIGNING_KEY_PEM=
# 32 byte ngẫu nhiên mã hoá base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
CP_SECRETS_KEY=
